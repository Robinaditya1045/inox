# ==============================================================================
# Inox backend — production environment (Oracle Cloud VM)
# ==============================================================================
# Copy to .env.prod on the server and fill in real secrets:
#   cp .env.prod.example .env.prod
# .env.prod is git-ignored and is read by BOTH docker compose (for ${...}
# interpolation in docker-compose.prod.yml) and the backend/worker containers.

# --- Deployed image ---
# Managed by CI: the deploy job rewrites this line to the image it just pushed,
# so every compose invocation on the host resolves the same commit. Rolling back
# is a matter of pointing it at an older tag and re-running compose up.
# Left unset, compose falls back to a locally built inox-backend:latest.
#BACKEND_IMAGE=ghcr.io/robinaditya1045/inox-backend:latest

# --- Runtime ---
APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info

# --- Public identity ---
# PUBLIC_HOST is the TLS hostname Caddy obtains a certificate for.
# PUBLIC_IP is the VM's public address; the SFU advertises it as its ICE host
# candidate, because the VM itself only ever sees its private 10.0.0.x address.
PUBLIC_HOST=CHANGE_ME.sslip.io
PUBLIC_IP=CHANGE_ME

# --- PostgreSQL ---
POSTGRES_USER=inox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inox
# Host-networked containers reach the loopback-published port, not a compose DNS name.
DATABASE_URL=postgres://inox:CHANGE_ME@127.0.0.1:5432/inox?sslmode=disable

# --- Redis (sessions + asynq queue + cross-process WS event bus) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Sessions ---
# Must be >= 32 chars and not the in-repo default, or config.Load() refuses to boot.
SESSION_SECRET=CHANGE_ME
SESSION_DURATION_HOURS=168

# --- MinIO object storage ---
MINIO_ROOT_USER=inoxadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=inox-media

# --- Media ---
# Local-disk fallback path, used only if MinIO is unreachable at boot.
STORAGE_DIR=/app/storage_data
MEDIA_STREAM_BASE_URL=https://CHANGE_ME.sslip.io/media/stream

# --- Live channels ---
LIVE_PROXY_BASE_URL=https://CHANGE_ME.sslip.io/api/v1/live
# Outbound fetch allowlist. Empty means every live-channel resolve is refused in
# production — that is the safe default; add hosts only as you need them.
LIVE_SOURCE_ALLOWED_HOSTS=

# --- CORS ---
# Exact origin match, no wildcards and no trailing slash. Vercel preview
# deployments get their own hostnames, so add them here if you need them to work.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.vercel.app,https://CHANGE_ME.sslip.io

# --- Admin access ---
# There is no role column on users; listing an address here is the only thing
# that grants /api/v1/admin/* and /metrics.
ADMIN_EMAILS=CHANGE_ME

# --- WebRTC / SFU ---
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Keep in sync with the UDP range opened in firewalld and the OCI security list.
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50100
WEBRTC_PUBLIC_IP=CHANGE_ME
